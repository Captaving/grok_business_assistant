# Обязательные
BOT_TOKEN=123456789:AA...            # токен от @BotFather
OWNER_ID=123456789                   # твой Telegram ID — бот пишет только тебе
GROQ_API_KEY=gsk_...                 # бесплатный ключ: https://console.groq.com/keys

# Необязательные (ниже значения по умолчанию)
BATCH_DELAY=180                      # сколько секунд тишины ждать перед сводкой
FORWARD_DELAY=30                     # то же для пересланных боту сообщений
TIMEZONE=Europe/Moscow
SEND_TRANSCRIPT=1                    # 1 — присылать полную расшифровку файлом
STT_MODEL=whisper-large-v3
STT_LANGUAGE=ru
LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
